# Veritas Daily - server configuration
# Copy to .env and fill in. Only the first block is required.

# --- Required ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/news-filter
JWT_SECRET=replace_with_a_long_random_string_at_least_64_characters
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173
NEWSAPI_KEY=

# --- AI: Claude via the Anthropic API (optional: falls back to heuristics when empty) ---
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=

# --- Email (optional: needed for password reset and digests) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com
FROM_NAME=Veritas Daily

# --- Caching (optional: leave REDIS_HOST empty to disable) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Search (optional: leave empty to use MongoDB text search) ---
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# --- Hidden / experimental features (off by default) ---
ENABLE_VIRAL_DETECTION=false
X_BEARER_TOKEN=

# --- Product ---
# Timezone that defines a user's "day" for briefings, streaks and the morning email
APP_TIMEZONE=Asia/Kolkata
# Free plan: story checks per day before the Pro prompt
FREE_DAILY_VERIFICATIONS=5
# Public URL of this API (used for unsubscribe links in emails)
API_URL=http://localhost:5000

# --- Background jobs ---
# Local dev runs jobs in-process. On a host that sleeps (e.g. Render free), set
# ENABLE_CRON=false and trigger jobs via POST /api/internal/jobs/:name instead.
ENABLE_CRON=true
# Shared secret for /api/internal/jobs (generate a long random string)
JOB_SECRET=
# Optional schedule overrides (cron syntax)
FETCH_SCHEDULE=0 */3 * * *
FETCH_INDIA_SCHEDULE=30 */3 * * *
ENRICH_SCHEDULE=45 */3 * * *
DIGEST_SCHEDULE=0 7 * * *

# --- Logging ---
LOG_LEVEL=info